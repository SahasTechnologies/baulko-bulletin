node_modules/
dist/
.astro/

# Copied out of node_modules/pdfjs-dist by scripts/sync-pdfjs-assets.mjs,
# which `npm install` and `npm run build` both run.
public/pdfjs/
.env
.env.local
.env*.local
.DS_Store
*.log
.vercel/
.*/

# The rule above ignores every dot-directory, which would silently swallow the
# CI workflow. .github/ is the one that has to be tracked.
!.github/
