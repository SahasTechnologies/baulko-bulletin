---
import NavLinks from "@/components/NavLinks.astro";
import Logo from "@/components/ui/Logo.astro";

interface Props {
  brand?: string;
}

const brand = Astro.props.brand || "Baulko Bulletin";
---

{/* `flip-row` moves the brand and the nav between their stacked and side-by-side
    arrangements instead of swapping them; see src/lib/layout-flip.ts. */}
<div class="flip-row mb-8 mt-10 flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
  <a href="/" class="flex gap-2 sm:gap-3 items-center hover:underline text-3xl font-bold leading-tight tracking-tight sm:text-4xl md:tracking-tighter">
    <Logo />
    {brand}
  </a>
  <NavLinks />
</div>
