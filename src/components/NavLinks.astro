---
import Icon from "@/components/ui/Icon.astro";
import ThemeToggle from "@/components/ui/ThemeToggle";

interface Props {
  class?: string;
}

const extraClass = Astro.props.class || "";

const links = [
  { href: "/", icon: "home", label: "Home" },
  { href: "/posts", icon: "newspaper", label: "Articles" },
  { href: "/extras", icon: "color-wand", label: "Extras" },
  { href: "/puzzles", icon: "extension-puzzle", label: "Puzzles" },
  { href: "/about", icon: "information-circle", label: "About" },
  { href: "/faq", icon: "help-circle", label: "FAQ" },
  { href: "/join", icon: "people", label: "Join" },
  { href: "/contact", icon: "chatbubbles", label: "Contact" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);
---

{/* One run of cells, written flat: the row is a plain wrapping flex line, so it
    spills onto a second line wherever it runs out of room and nothing has to
    decide which cells go where. Every link shows its icon beside its name at
    every width — see the `.icon-nav` rules in global.css for why. */}
<nav class:list={["icon-nav text-xl font-medium", extraClass]}>
  {
    links.map((link) => (
      <div class="icon-nav-item">
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class="icon-nav-link"
        >
          <Icon name={link.icon} />
          <span class="icon-nav-label">{link.label}</span>
        </a>
      </div>
    ))
  }
  {/* The switch rides at the end of the row, the way it always has. */}
  <div class="icon-nav-item">
    <ThemeToggle client:load />
  </div>
</nav>

{/* Nothing here has to be measured or re-arranged on a resize any more. The row
    still takes part in `src/lib/layout-flip.ts` — it is a row like any other,
    and eases across a breakpoint with the rest of the page — but it no longer
    has a shape of its own for the flip to watch for. */}
