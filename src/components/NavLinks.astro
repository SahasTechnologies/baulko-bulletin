---
import Icon from "@/components/ui/Icon.astro";
import ThemeToggle from "@/components/ui/ThemeToggle";

interface Props {
  class?: string;
}

const extraClass = Astro.props.class || "";

const links = [
  { href: "/", icon: "home", label: "Home" },
  { href: "/posts", icon: "newspaper", label: "Articles" },
  { href: "/extras", icon: "color-wand", label: "Extras" },
  { href: "/puzzles", icon: "extension-puzzle", label: "Puzzles" },
  { href: "/about", icon: "information-circle", label: "About" },
  { href: "/faq", icon: "help-circle", label: "FAQ" },
  { href: "/join", icon: "people", label: "Join" },
  { href: "/contact", icon: "chatbubbles", label: "Contact" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav class:list={["icon-nav text-xl font-medium", extraClass]}>
  {
    links.map((link) => (
      <div class="icon-nav-item">
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class="icon-nav-link"
        >
          <Icon name={link.icon} />
          <span class="icon-nav-label">{link.label}</span>
        </a>
      </div>
    ))
  }
  <div class="icon-nav-item">
    <ThemeToggle client:load />
  </div>
</nav>

{/* Eases this row and the header around it across their breakpoints, instead
    of swapping one shape for the other. */}
<script>
  import { initLayoutTransition } from "@/lib/layout-flip";

  initLayoutTransition();
</script>
