---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import MoreStories from "@/components/ui/MoreStories";
import { croppedSquareUrl } from "@/lib/images";
import { getSettings, getPuzzles, getMorePosts } from "@/lib/db";

const settings = await getSettings();
const puzzles = await getPuzzles();
const morePosts = await getMorePosts(2);

function formatDate(value: string) {
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("en", { day: "numeric", month: "short", year: "numeric" });
}
---

<BaseLayout title="Puzzles" settings={settings}>
  <div class="container mx-auto px-5">
    <PageHeader brand={settings.title} />
    <article class="mx-auto max-w-2xl">
      <h1 class="mb-6 text-balance text-5xl font-bold leading-tight tracking-tighter md:text-6xl md:leading-none lg:text-7xl">
        Puzzles
      </h1>
      <div class="grid grid-cols-3 gap-4">
        {puzzles.map((puzzle, index) => {
          const cover = croppedSquareUrl(puzzle.cover_image_url);
          return (
            <a class="group transition" href={`/puzzles/${index}`}>
              <div class="rounded-xl shadow-md p-8 aspect-square text-5xl font-black font-mono flex justify-end items-end text-slate-200 bg-slate-800 group-hover:scale-105 group-hover:shadow-2xl group-hover:shadow-white/40 dark:group-hover:shadow-white/10 transition relative overflow-hidden">
                {cover && (
                  <img src={cover} alt={puzzle.title} width={1000} height={1000} class="absolute inset-0 size-full object-cover rounded-xl" />
                )}
                <div class="relative z-10 drop-shadow-[0_5px_10px_black]">{index.toString().padStart(2, "0")}</div>
              </div>
              <div class="group-hover:scale-110 transition origin-top group-hover:translate-y-2">
                <div class="font-semibold">{puzzle.title}</div>
                <div class="opacity-50">
                  {puzzle.type}&nbsp;|&nbsp;{formatDate(puzzle.date)}
                </div>
                <div class="opacity-50">
                  by {puzzle.author_name || "Anonymous"}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </article>
    <hr class="border-black/10 dark:border-white/10 my-16" />
    <MoreStories client:load posts={morePosts} heading="Recent Issues" />
  </div>
</BaseLayout>
