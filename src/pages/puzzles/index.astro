---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSettings, getPuzzles } from "@/lib/db";

const settings = await getSettings();
const puzzles = await getPuzzles();
---

<BaseLayout title="Puzzles" settings={settings}>
  <div class="container mx-auto px-5">
    <h2 class="mb-8 mt-10 text-3xl font-bold leading-tight tracking-tight sm:text-4xl md:tracking-tighter">
      <a href="/" class="flex gap-2 sm:gap-3 items-center hover:underline">
        <img alt="Bulletin logo" class="size-[60px]" height={350} width={350} src="/bulletin.png" />
        Baulko Bulletin
      </a>
    </h2>

    <h1 class="mb-12 text-6xl font-bold leading-tight tracking-tighter md:text-7xl">
      Puzzles
    </h1>

    {puzzles.length === 0 ? (
      <p class="text-xl opacity-70">No puzzles published yet.</p>
    ) : (
      <ul class="space-y-6">
        {puzzles.map((puzzle, index) => (
          <li>
            <a href={`/puzzles/${index}`} class="text-2xl font-bold hover:underline">
              {puzzle.title}
              <span class="ml-3 text-lg font-normal opacity-60">({puzzle.type})</span>
            </a>
            {(puzzle.author_name || puzzle.post_title) && (
              <p class="text-base opacity-60 mt-1">
                {puzzle.author_name && <span>by {puzzle.author_name}</span>}
                {puzzle.author_name && puzzle.post_title && <span> · </span>}
                {puzzle.post_title && (
                  <a href={`/posts/${puzzle.post_slug}`} class="hover:underline">
                    from {puzzle.post_title}
                  </a>
                )}
              </p>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
