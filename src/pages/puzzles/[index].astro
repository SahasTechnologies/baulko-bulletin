---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Crossword } from "@/components/puzzles/Crossword";
import { FindAWord } from "@/components/puzzles/FindAWord";
import { Unscramble } from "@/components/puzzles/Unscramble";
import MoreStories from "@/components/ui/MoreStories";
import { getSettings, getPuzzles, getMorePosts } from "@/lib/db";

const { index } = Astro.params;
const settings = await getSettings();
const puzzles = await getPuzzles();
const puzzle = puzzles[parseInt(index!, 10)];

if (!puzzle) {
  return Astro.redirect("/puzzles");
}

const article = puzzle.type === "Unscramble" ? "an" : "a";
const morePosts = await getMorePosts(2);
---

<BaseLayout title={puzzle.title} settings={settings}>
  <div class="container mx-auto px-5">
    <h2 class="mb-8 mt-10 text-3xl font-bold leading-tight tracking-tight sm:text-4xl md:tracking-tighter">
      <a href="/" class="flex gap-2 sm:gap-3 items-center hover:underline">
        <img alt="Bulletin logo" class="size-[60px]" height={350} width={350} src="/bulletin.png" />
        Baulko Bulletin
      </a>
    </h2>
    <article>
      <h1 class="text-balance text-6xl font-bold leading-tight tracking-tighter md:text-7xl">
        {puzzle.title}
      </h1>
      <h2 class="text-balance mb-12 text-xl font-semibold leading-tight tracking-tighter md:text-2xl lg:text-3xl opacity-50">
        {article} {puzzle.type} puzzle, by {puzzle.author_name || "Anonymous"}
      </h2>
      {puzzle.type === "Crossword" && (
        <Crossword client:load puzzle={{ data: puzzle.data }} />
      )}
      {puzzle.type === "Find-A-Word" && (
        <FindAWord client:load puzzle={{ data: puzzle.data }} />
      )}
      {puzzle.type === "Unscramble" && (
        <Unscramble client:load puzzle={{ data: puzzle.data }} />
      )}
    </article>
    <hr class="border-black/10 dark:border-white/10 mb-24 mt-28" />
    <MoreStories client:load posts={morePosts} heading="Recent Issues" />
  </div>
</BaseLayout>
