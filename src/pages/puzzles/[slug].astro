---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { Crossword } from "@/components/puzzles/Crossword";
import { FindAWord } from "@/components/puzzles/FindAWord";
import { Unscramble } from "@/components/puzzles/Unscramble";
import { Sudoku } from "@/components/puzzles/Sudoku";
import { Cryptogram } from "@/components/puzzles/Cryptogram";
import { Connections } from "@/components/puzzles/Connections";
import { Nonogram } from "@/components/puzzles/Nonogram";
import { isPuzzleTypeName } from "@/lib/puzzle-data";
import MoreStories from "@/components/ui/MoreStories";
import { croppedSquareUrl } from "@/lib/images";
import { getSettings, getPuzzleBySlug, getPuzzleByIndex, getRecentPosts } from "@/lib/db";

const { slug } = Astro.params;
const settings = await getSettings();

// Puzzles used to be addressed by their position in the newest-first list, and
// those numeric URLs were live for months. They still resolve — by redirecting
// to the slug. Temporary rather than permanent on purpose: a position is only
// correct until the next puzzle is added or re-dated, so a cached permanent
// redirect would eventually send readers to the wrong puzzle.
if (slug !== undefined && /^\d+$/.test(slug)) {
  const found = await getPuzzleByIndex(Number.parseInt(slug, 10));
  if (found) return Astro.redirect(`/puzzles/${found.slug}`, 302);
  return Astro.redirect("/puzzles", 302);
}

const puzzle = await getPuzzleBySlug(slug ?? "");

if (!puzzle) {
  // A real 404, as posts and extras already serve. A puzzle whose publication
  // moment has not arrived reads as missing here, so it has to answer the same
  // way a slug that was never used does — redirecting to /puzzles would reply
  // differently for a slug that exists and one that does not, which is a way of
  // announcing content that is not public yet.
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const article = puzzle.type === "Unscramble" ? "an" : "a";

/**
 * A standalone puzzle's own picture, if it has one.
 *
 * A puzzle inside an issue borrows that issue's cover for its tile, and the
 * cover is already on the issue's own page — showing it again here would be the
 * same magazine cover twice. A puzzle that belongs to no issue has no such
 * page, so this is the only place its art appears.
 */
const ownArt = puzzle.post_id ? null : croppedSquareUrl(puzzle.cover_image_url);

/**
 * Whether any reader on this page knows this puzzle's type.
 *
 * Asked of the parser's own list rather than kept here: a type the panel can
 * save and the readers cannot draw used to be discoverable only by opening the
 * page, and this is the one list that cannot disagree with itself.
 */
const playable = isPuzzleTypeName(puzzle.type);
const morePosts = await getRecentPosts(2);
---

<BaseLayout title={puzzle.title} settings={settings}>
  <div class="container mx-auto px-5">
    <PageHeader brand={settings.title} />
    <article>
      <h1 class="text-balance text-6xl font-bold leading-tight tracking-tighter md:text-7xl">
        {puzzle.title}
      </h1>
      <h2 class="text-balance mb-12 text-xl font-semibold leading-tight tracking-tighter md:text-2xl lg:text-3xl opacity-50">
        {article} {puzzle.type} puzzle, by {puzzle.author_name || "Anonymous"}
      </h2>
      {ownArt && (
        <img
          src={ownArt}
          alt={puzzle.title}
          width={1000}
          height={1000}
          class="mb-12 size-56 rounded-2xl object-cover shadow-md sm:size-72"
        />
      )}
      {
        /* Each reader is written out rather than looked up in a map: a client
           directive has to sit on a component the compiler can name, so
           `<Reader client:load />` — a variable holding one of these — rendered
           nothing at all in either the HTML or the browser, and every puzzle
           page came out empty below its title. */
      }
      {(puzzle.type === "Crossword" || puzzle.type === "Cross-number") && (
        <Crossword client:load puzzle={{ data: puzzle.data }} />
      )}
      {puzzle.type === "Find-A-Word" && <FindAWord client:load puzzle={{ data: puzzle.data }} />}
      {puzzle.type === "Unscramble" && <Unscramble client:load puzzle={{ data: puzzle.data }} />}
      {puzzle.type === "Sudoku" && <Sudoku client:load puzzle={{ data: puzzle.data }} />}
      {puzzle.type === "Cryptogram" && <Cryptogram client:load puzzle={{ data: puzzle.data }} />}
      {puzzle.type === "Connections" && <Connections client:load puzzle={{ data: puzzle.data }} />}
      {puzzle.type === "Nonogram" && <Nonogram client:load puzzle={{ data: puzzle.data }} />}
      {!playable && (
        <div class="max-w-2xl rounded-2xl border border-amber-500/40 bg-amber-500/10 px-6 py-5">
          <p class="mb-1 font-semibold">This puzzle can’t be played here yet.</p>
          <p class="opacity-80">
            It is stored as “{puzzle.type}”, which no reader on this page understands. Choose one of
            the types the panel offers to make it playable.
          </p>
        </div>
      )}
    </article>
    <hr class="border-black/10 dark:border-white/10 mb-24 mt-28" />
    <MoreStories client:load posts={morePosts} heading="Recent Issues" />
  </div>
</BaseLayout>
