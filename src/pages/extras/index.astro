---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SearchableCards from "@/components/ui/SearchableCards";
import { getSettings, getAllExtras } from "@/lib/db";

const settings = await getSettings();
const extras = await getAllExtras();
---

<BaseLayout title="Extras" settings={settings}>
  <div class="container mx-auto px-5">
    <PageHeader brand={settings.title} />
    <h1 class="mb-12 text-6xl font-bold leading-tight tracking-tighter md:text-7xl">
      Extras
    </h1>
    {extras.length === 0 ? (
      <p class="text-xl opacity-70">No extras published yet.</p>
    ) : (
      <SearchableCards client:load items={extras} kind="extra" />
    )}
  </div>
</BaseLayout>
