---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import CoverImage from "@/components/ui/CoverImage";
import DateComponent from "@/components/ui/DateComponent";
import MoreStories from "@/components/ui/MoreStories";
import Byline from "@/components/ui/Byline";
import { getSettings, getExtraBySlug, getRecentPosts } from "@/lib/db";
import { sanitizeHtml } from "@/lib/sanitize-html";

const { slug } = Astro.params;
const settings = await getSettings();
const extra = await getExtraBySlug(slug!);

if (!extra) {
  // Served as a 404 in place, not redirected to /404 — see the note in
  // posts/[slug].astro.
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

// Filtered on the way out as well as on the way in — see about.astro.
const content = sanitizeHtml(extra.content);

const morePosts = await getRecentPosts(2);
---

<BaseLayout title={extra.title} description={extra.excerpt || undefined} settings={settings} ogImage={extra.cover_image_url}>
  <div class="container mx-auto px-5">
    <PageHeader brand={settings.title} />
    <article>
      <h1 class="text-balance mb-4 text-6xl font-bold leading-tight tracking-tighter md:text-7xl md:leading-none lg:text-8xl">
        {extra.title}
      </h1>
      <div class="mb-4">
        <Byline client:load name={extra.author_name?.trim() || "Anonymous"} />
      </div>
      <div class="mb-8 sm:mx-0 md:mb-16">
        <CoverImage client:load src={extra.cover_image_url} alt={extra.cover_image_alt} priority />
      </div>
      <div class="mx-auto max-w-2xl">
        <div class="mb-6 text-lg opacity-70">
          <DateComponent client:load dateString={extra.date} />
        </div>
        <div class="prose prose-lg dark:prose-invert max-w-none" set:html={content} />
      </div>
    </article>
    <hr class="border-black/10 dark:border-white/10 mb-24 mt-28" />
    <MoreStories client:load posts={morePosts} heading="Recent Issues" />
  </div>
</BaseLayout>
