---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NavLinks from "@/components/NavLinks.astro";
import CoverImage from "@/components/ui/CoverImage";
import DateComponent from "@/components/ui/DateComponent";
import MoreStories from "@/components/ui/MoreStories";
import Byline from "@/components/ui/Byline";
import { getSettings, getLatestPost, getMorePosts, getAllExtras } from "@/lib/db";

const settings = await getSettings();
const heroPost = await getLatestPost();
const morePosts = await getMorePosts(5);
const extras = await getAllExtras(5);
---

<BaseLayout settings={settings}>
  <div class="container mx-auto px-5">
    <section class="mt-12 mb-12 flex flex-col items-center lg:mb-10 lg:flex-row lg:items-center lg:justify-evenly">
      <img
        alt="Bulletin logo of orange"
        class="size-[180px] lg:size-[230px]"
        height={350}
        width={350}
        src="/bulletin.png"
      />
      <h1 class="text-center lg:text-start text-6xl font-bold leading-none tracking-tighter lg:pr-8 lg:text-7xl">
        {settings.title}
      </h1>
      <h2 class="flex flex-col gap-3 text-pretty items-center mt-5 text-center text-lg lg:mt-0 lg:pl-8 lg:text-left lg:items-start">
        <NavLinks />
        <p class="text-lg opacity-70">{settings.description}</p>
      </h2>
    </section>

    {heroPost ? (
      <article>
        <h2 class="mb-8 text-4xl font-bold leading-tight tracking-tighter md:text-5xl">
          Our Latest Issue
        </h2>
        <a class="group mb-8 block md:mb-16" href={`/posts/${heroPost.slug}`}>
          <CoverImage client:load src={heroPost.cover_image_url} alt={heroPost.cover_image_alt} priority />
        </a>
        <div class="mb-20 md:mb-28 md:grid md:grid-cols-2 md:gap-x-16 lg:gap-x-8">
          <div>
            <h3 class="text-pretty mb-2 font-bold text-4xl leading-tight tracking-tighter lg:text-6xl">
              <a href={`/posts/${heroPost.slug}`} class="hover:underline">
                {heroPost.title}
              </a>
            </h3>
            <div class="mb-4 text-xl md:mb-0 font-medium opacity-70">
              <DateComponent client:load dateString={heroPost.date} />
            </div>
          </div>
          <div>
            {heroPost.excerpt && (
              <p class="text-pretty mb-4 text-lg">{heroPost.excerpt}</p>
            )}
            <Byline client:load name="Team Bulletin" />
          </div>
        </div>
      </article>
    ) : null}

    <MoreStories client:load posts={morePosts} extras={extras} heading="Previous Issues" showAllIssuesLink showAllExtrasLink />
  </div>
</BaseLayout>
