---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getSettings, getPage } from "@/lib/db";

const settings = await getSettings();
const page = await getPage("join");
---

<BaseLayout title={page.title} settings={settings} ogImage={page.og_image_url}>
  <div class="container mx-auto px-5">
    <PageHeader brand={settings.title} />
    <article class="mx-auto max-w-2xl">
      <h1 class="mb-12 text-6xl font-bold leading-tight tracking-tighter md:text-7xl">
        {page.title}
      </h1>
      <div class="prose prose-lg dark:prose-invert" set:html={page.body_html} />
    </article>
  </div>
</BaseLayout>
