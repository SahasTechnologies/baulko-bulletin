---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Flash from "@/components/admin/Flash.astro";
import Icon from "@/components/ui/Icon.astro";
import { ENTITIES, isEntityKey, type ContentRow } from "@/lib/admin-entities";
import { listRows } from "@/lib/admin-db";
import { flashFromUrl } from "@/lib/admin";
import { isDue, isoToDateInput, isoToTimeInput } from "@/lib/publish-time";

export const prerender = false;

if (!Astro.locals.adminSession) return Astro.redirect("/admin/login");

const { entity } = Astro.params;
if (!isEntityKey(entity)) return Astro.redirect("/admin?error=Unknown+content+type.");

const def = ENTITIES[entity];
const base = `/admin/${def.key}`;
const flash = flashFromUrl(Astro.url);
const csrf = Astro.locals.adminCsrf;

let rows: ContentRow[] = [];
let dbError: string | null = null;
try {
  rows = await listRows(def.key);
} catch (err) {
  dbError = err instanceof Error ? err.message : String(err);
}

function cell(row: ContentRow, field: string): string {
  if (field === "date") return isoToDateInput(row.date);
  const value = row[field];
  return value == null || value === "" ? "—" : value;
}

/**
 * A row dated in the future is invisible on the site — absent from every
 * listing and 404 on its own page — and nothing else in the panel says so. The
 * list is where that has to be legible, or an editor schedules something and
 * then goes looking for it on the live site.
 */
function scheduledFor(row: ContentRow): string | null {
  if (isDue(row.date)) return null;
  return `${isoToDateInput(row.date)} ${isoToTimeInput(row.date)}`;
}

/**
 * The row's actions are icons rather than words — three words per row read as a
 * paragraph of links down the side of a table. Each one keeps its own
 * `aria-label`, because an inline icon is hidden from assistive technology (see
 * `components/ui/Icon.astro`) and an unlabelled button says nothing.
 */
const actionClass =
  "inline-flex size-9 items-center justify-center rounded-full border border-black/15 text-lg transition-transform hover:scale-110 dark:border-white/15";
const deleteClass =
  "inline-flex size-9 items-center justify-center rounded-full border border-red-500/40 text-lg text-red-700 transition-transform hover:scale-110 dark:text-red-400";
---

<AdminLayout title={def.plural} current={base}>
  {flash && <Flash kind={flash.kind} message={flash.message} />}

  {dbError && (
    <div class="mb-8 rounded-2xl border border-red-500/40 bg-red-500/10 px-6 py-5">
      <p class="mb-1 font-semibold">Could not load {def.plural.toLowerCase()}.</p>
      <p class="font-mono text-sm opacity-80">{dbError}</p>
    </div>
  )}

  <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
    <div>
      <h1 class="text-5xl font-bold leading-tight tracking-tighter">{def.plural}</h1>
    </div>
    <a
      href={`${base}/new`}
      class="inline-flex items-center gap-2 rounded-full bg-black px-7 py-3 text-lg font-bold text-white transition-transform hover:scale-105 dark:bg-white dark:text-black"
    >
      <Icon name="add" />
      New {def.singular.toLowerCase()}
    </a>
  </div>

  {
    rows.length === 0 ? (
      <p class="rounded-2xl border border-black/10 p-8 text-lg opacity-70 dark:border-white/15">
        No {def.plural.toLowerCase()} yet.
      </p>
    ) : (
      <div class="overflow-x-auto rounded-2xl border border-black/10 dark:border-white/15">
        <table class="w-full border-collapse text-left">
          <thead class="bg-black/5 text-sm dark:bg-white/5">
            <tr>
              {def.columns.map((column) => (
                <th scope="col" class="px-5 py-3 font-semibold">
                  {column.label}
                </th>
              ))}
              <th scope="col" class="px-5 py-3 font-semibold">
                Actions
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => {
              const preview = def.publicHref(row);
              const scheduled = scheduledFor(row);
              return (
                <tr class="border-t border-black/10 align-middle dark:border-white/10">
                  {def.columns.map((column) => (
                    <td class="px-5 py-4">
                      {column.field === "title" ? (
                        <a href={`${base}/${row.id}`} class="font-semibold hover:underline">
                          {cell(row, "title")}
                        </a>
                      ) : column.field === "date" ? (
                        <span class="opacity-80">
                          {cell(row, column.field)}
                          {scheduled && (
                            <span
                              class="ml-2 whitespace-nowrap rounded-full border border-amber-500/50 bg-amber-500/10 px-2 py-0.5 text-xs font-semibold text-amber-800 dark:text-amber-300"
                              title={`Not on the site until ${scheduled} Sydney`}
                            >
                              Scheduled {scheduled.slice(11)}
                            </span>
                          )}
                        </span>
                      ) : (
                        <span class="opacity-80">{cell(row, column.field)}</span>
                      )}
                    </td>
                  ))}
                  <td class="px-5 py-4">
                    <div class="flex items-center gap-2 whitespace-nowrap">
                      <a
                        href={`${base}/${row.id}`}
                        class={actionClass}
                        title={`Edit ${cell(row, "title")}`}
                        aria-label={`Edit ${cell(row, "title")}`}
                      >
                        <Icon name="create-outline" />
                      </a>
                      {preview && (
                        <a
                          href={preview}
                          target="_blank"
                          rel="noreferrer"
                          class={actionClass}
                          title={`View ${cell(row, "title")} on the site`}
                          aria-label={`View ${cell(row, "title")} on the site`}
                        >
                          <Icon name="eye-outline" />
                        </a>
                      )}
                      <form
                        action="/api/admin/content"
                        method="POST"
                        data-confirm={`Delete “${cell(row, "title")}”? This cannot be undone.`}
                      >
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="entity" value={def.key} />
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={row.id} />
                        <button
                          type="submit"
                          class={deleteClass}
                          title={`Delete ${cell(row, "title")}`}
                          aria-label={`Delete ${cell(row, "title")}`}
                        >
                          <Icon name="trash" />
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )
  }

  <p class="mt-6 text-sm opacity-60">
    {rows.length} {rows.length === 1 ? def.singular.toLowerCase() : def.plural.toLowerCase()}
  </p>
</AdminLayout>
