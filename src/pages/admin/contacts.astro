---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Flash from "@/components/admin/Flash.astro";
import { listRecipients } from "@/lib/admin-db";
import { flashFromUrl } from "@/lib/admin";
import { resendConfigured, senderAddress } from "@/lib/mail";

export const prerender = false;

if (!Astro.locals.adminSession) return Astro.redirect("/admin/login");

const csrf = Astro.locals.adminCsrf;
const flash = flashFromUrl(Astro.url);

let recipients: Awaited<ReturnType<typeof listRecipients>> = [];
let dbError: string | null = null;
try {
  recipients = await listRecipients();
} catch (err) {
  dbError = err instanceof Error ? err.message : String(err);
}

const active = recipients.filter((r) => r.active).length;
const inputClass =
  "w-full rounded-xl border border-black/15 bg-white px-4 py-2.5 dark:border-white/15 dark:bg-neutral-900 focus:outline-none focus:ring-2 focus:ring-black/30 dark:focus:ring-white/30";
---

<AdminLayout title="Contacts" current="/admin/contacts">
  {flash && <Flash kind={flash.kind} message={flash.message} />}

  <h1 class="mb-2 text-5xl font-bold leading-tight tracking-tighter">Contact recipients</h1>
  <p class="mb-10 max-w-3xl text-lg opacity-70">
    Every message sent through the contact form is emailed to these addresses. {active} of {recipients.length}
    {recipients.length === 1 ? "address is" : "addresses are"} active.
  </p>

  {
    dbError && (
      <div class="mb-8 rounded-2xl border border-red-500/40 bg-red-500/10 px-6 py-5">
        <p class="mb-1 font-semibold">Could not load the recipient list.</p>
        <p class="font-mono text-sm opacity-80">{dbError}</p>
      </div>
    )
  }

  {
    !resendConfigured() && (
      <div class="mb-8 rounded-2xl border border-amber-500/40 bg-amber-500/10 px-6 py-5">
        <p class="mb-1 font-semibold">RESEND_API_KEY is not set.</p>
        <p class="opacity-80">
          Submissions are saved to Messages, but nothing is emailed until the key is added to the
          environment. A test send will say the same thing.
        </p>
      </div>
    )
  }

  <section class="mb-12 rounded-2xl border border-black/10 p-6 dark:border-white/15">
    <h2 class="mb-1 text-2xl font-bold tracking-tight">Send a test</h2>
    <p class="mb-4 opacity-70">
      Emails every active address from {senderAddress()} so you can confirm delivery end to end.
    </p>
    <form action="/api/admin/contacts" method="POST">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="action" value="test" />
      <button
        type="submit"
        class="inline-flex items-center gap-2 rounded-full bg-black px-7 py-3 text-lg font-bold text-white transition-transform hover:scale-105 dark:bg-white dark:text-black"
      >
        <ion-icon name="paper-plane"></ion-icon>
        Send test email
      </button>
    </form>
  </section>

  <section class="mb-12">
    <h2 class="mb-5 text-2xl font-bold tracking-tight">Addresses</h2>
    {
      recipients.length === 0 ? (
        <p class="rounded-2xl border border-black/10 p-8 text-lg opacity-70 dark:border-white/15">
          Nobody is on the list yet, so contact messages are only saved to Messages.
        </p>
      ) : (
        <div class="space-y-4">
          {recipients.map((recipient) => (
            <div class="rounded-2xl border border-black/10 p-5 dark:border-white/15">
              <form
                action="/api/admin/contacts"
                method="POST"
                class="grid gap-4 md:grid-cols-[1fr_1fr_auto_auto]"
              >
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="action" value="update" />
                <input type="hidden" name="id" value={recipient.id} />
                <label class="flex flex-col text-sm">
                  <span class="mb-1 font-medium">Email</span>
                  <input
                    name="email"
                    type="email"
                    required
                    maxlength="320"
                    value={recipient.email}
                    class={inputClass}
                  />
                </label>
                <label class="flex flex-col text-sm">
                  <span class="mb-1 font-medium">Label (optional)</span>
                  <input
                    name="name"
                    type="text"
                    maxlength="120"
                    value={recipient.name ?? ""}
                    placeholder="Editor"
                    class={inputClass}
                  />
                </label>
                <label class="flex items-center gap-2 self-end pb-2 text-sm">
                  <input type="checkbox" name="active" checked={recipient.active} />
                  Receives messages
                </label>
                <div class="flex items-end gap-4 pb-2 text-sm">
                  <button type="submit" class="underline underline-offset-4">
                    Save
                  </button>
                </div>
              </form>

              <form
                action="/api/admin/contacts"
                method="POST"
                class="mt-3"
                onsubmit={`return confirm('Remove ${recipient.email} from the list?')`}
              >
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={recipient.id} />
                <button
                  type="submit"
                  class="text-sm text-red-700 underline underline-offset-4 dark:text-red-400"
                >
                  Remove
                </button>
              </form>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <section class="rounded-2xl border border-black/10 p-6 dark:border-white/15">
    <h2 class="mb-5 text-2xl font-bold tracking-tight">Add an address</h2>
    <form action="/api/admin/contacts" method="POST" class="grid gap-4 md:grid-cols-[1fr_1fr_auto]">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="action" value="add" />
      <label class="flex flex-col text-sm">
        <span class="mb-1 font-medium">Email</span>
        <input name="email" type="email" required maxlength="320" class={inputClass} />
      </label>
      <label class="flex flex-col text-sm">
        <span class="mb-1 font-medium">Label (optional)</span>
        <input name="name" type="text" maxlength="120" placeholder="Editor" class={inputClass} />
      </label>
      <div class="flex items-end">
        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-full bg-black px-6 py-3 font-bold text-white transition-transform hover:scale-105 dark:bg-white dark:text-black"
        >
          <ion-icon name="add"></ion-icon>
          Add
        </button>
      </div>
    </form>
  </section>
</AdminLayout>
