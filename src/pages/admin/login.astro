---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";
import { getSettings } from "@/lib/db";
import { adminConfigured, adminHashMalformed } from "@/lib/auth";
import { flashFromUrl, safeAdminPath } from "@/lib/admin";

export const prerender = false;

// Middleware has already resolved the session for this request.
if (Astro.locals.adminSession) {
  return Astro.redirect("/admin");
}

const settings = await getSettings();
const configured = adminConfigured();
const unusableHash = adminHashMalformed();
const flash = flashFromUrl(Astro.url);
const next = safeAdminPath(Astro.url.searchParams.get("next"));
const inputClass =
  "w-full rounded-xl border border-black/15 dark:border-white/15 dark:bg-neutral-900 px-4 py-3 text-lg focus:outline-none focus:ring-2 focus:ring-black/30 dark:focus:ring-white/30";
---

<BaseLayout title="Admin" settings={settings}>
  <div class="container mx-auto px-5">
    <div class="mx-auto mt-20 max-w-md">
      <div class="mb-8 flex items-center gap-3">
        <Logo class="size-[52px]" />
        <div>
          <h1 class="text-3xl font-bold leading-tight tracking-tighter">Bulletin Admin</h1>
          <p class="opacity-70">Staff access only.</p>
        </div>
      </div>

      {
        !configured ? (
          <div class="rounded-2xl border border-amber-500/40 bg-amber-500/10 px-6 py-5 text-lg">
            <p class="mb-2 font-semibold">Admin is not configured.</p>
            <p class="opacity-80">
              Set <code>ADMIN_PASSWORD_HASH</code> in the environment (and in your Vercel project
              settings) to switch the panel on — <code>npm run password:hash</code> prints the value
              for a password. Until then every login is rejected.
            </p>
          </div>
        ) : (
          <>
            {
              unusableHash && (
                <p
                  class="mb-6 rounded-2xl border border-red-500/40 bg-red-500/10 px-5 py-4 text-sm"
                  role="alert"
                >
                  <code>ADMIN_PASSWORD_HASH</code> is set but is not a hash this build can
                  read. It should look like{" "}
                  <code>pbkdf2-sha256.&lt;iterations&gt;.&lt;salt&gt;.&lt;hash&gt;</code> — paste the
                  output of <code>npm run password:hash</code> again, in full. Logins are refused
                  until it parses.
                </p>
              )
            }

            {flash && (
              <div
                class:list={[
                  "mb-6 rounded-2xl px-5 py-4",
                  flash.kind === "error"
                    ? "border border-red-500/40 bg-red-500/10"
                    : "border border-emerald-500/40 bg-emerald-500/10",
                ]}
                role={flash.kind === "error" ? "alert" : "status"}
              >
                {flash.message}
              </div>
            )}

            <form action="/api/admin/login" method="POST" class="space-y-5">
              <input type="hidden" name="next" value={next} />
              <div>
                <label for="password" class="mb-1 block text-sm font-medium">
                  Password
                </label>
                <input
                  id="password"
                  type="password"
                  name="password"
                  required
                  autofocus
                  autocomplete="current-password"
                  maxlength="512"
                  class={inputClass}
                />
              </div>
              <button
                type="submit"
                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-black py-3 px-8 text-lg font-bold text-white transition-transform hover:scale-[1.02] dark:bg-white dark:text-black"
              >
                <Icon name="lock-closed" />
                Sign in
              </button>
            </form>
          </>
        )
      }

    </div>
  </div>
</BaseLayout>
