---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Flash from "@/components/admin/Flash.astro";
import Icon from "@/components/ui/Icon.astro";
import { flashFromUrl } from "@/lib/admin";
import { adminConfigured, adminHashMalformed } from "@/lib/auth";
import { getCounts, listAuthorCount, type AdminCounts } from "@/lib/admin-db";

export const prerender = false;

if (!Astro.locals.adminSession) return Astro.redirect("/admin/login");

const flash = flashFromUrl(Astro.url);

let counts: AdminCounts | null = null;
let authors = 0;
let dbError: string | null = null;
try {
  counts = await getCounts();
  authors = await listAuthorCount();
} catch (err) {
  dbError = err instanceof Error ? err.message : String(err);
}

const configured = adminConfigured();
const unusableHash = adminHashMalformed();

const cards = [
  {
    href: "/admin/posts",
    label: "Issues",
    value: counts?.posts ?? 0,
    action: "New issue",
    icon: "newspaper",
  },
  {
    href: "/admin/extras",
    label: "Extras",
    value: counts?.extras ?? 0,
    action: "New extra",
    icon: "color-wand",
  },
  {
    href: "/admin/puzzles",
    label: "Puzzles",
    value: counts?.puzzles ?? 0,
    action: "New puzzle",
    icon: "extension-puzzle",
  },
];
---

<AdminLayout title="Dashboard" current="/admin">
  {flash && <Flash kind={flash.kind} message={flash.message} />}

  {
    !configured && (
      <div class="mb-8 rounded-2xl border border-red-500/40 bg-red-500/10 px-6 py-5">
        <p class="mb-1 font-semibold">ADMIN_PASSWORD_HASH is not set.</p>
        <p class="opacity-80">
          Add it to <code>.env</code> locally and to the Vercel project's environment variables, then
          redeploy — <code>npm run password:hash</code> prints one for a password. Logins are rejected
          until then.
        </p>
      </div>
    )
  }

  {
    unusableHash && (
      <div class="mb-8 rounded-2xl border border-red-500/40 bg-red-500/10 px-6 py-5" role="alert">
        <p class="mb-1 font-semibold">ADMIN_PASSWORD_HASH could not be read.</p>
        <p class="opacity-80">
          It should look like <code>pbkdf2-sha256.&lt;iterations&gt;.&lt;salt&gt;.&lt;hash&gt;</code>. A
          value containing <code>$</code> loses everything after it in <code>.env</code>, which is
          the usual cause — regenerate it with <code>npm run password:hash</code> and paste the
          whole line.
        </p>
      </div>
    )
  }

  {dbError && (
    <div class="mb-8 rounded-2xl border border-red-500/40 bg-red-500/10 px-6 py-5">
      <p class="mb-1 font-semibold">Could not read the database.</p>
      <p class="font-mono text-sm opacity-80">{dbError}</p>
    </div>
  )}

  <h1 class="mb-10 text-5xl font-bold leading-tight tracking-tighter">Dashboard</h1>

  <div class="mb-12 grid gap-6 md:grid-cols-3">
    {
      cards.map((card) => (
        <article class="flex flex-col rounded-2xl border border-black/10 p-6 dark:border-white/15">
          <div class="mb-3 flex items-center gap-2 text-lg font-medium opacity-70">
            <Icon name={card.icon} />
            {card.label}
          </div>
          <div class="text-5xl font-black tracking-tighter">{card.value}</div>
          <div class="mt-5 grow flex items-center gap-4">
            <a href={card.href} class="underline underline-offset-4">Manage</a>
            <a href={`${card.href}/new`} class="opacity-70 hover:opacity-100">+ {card.action}</a>
          </div>
        </article>
      ))
    }
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    <a
      href="/admin/messages"
      class="flex items-center justify-between rounded-2xl border border-black/10 p-6 transition-transform hover:scale-[1.02] dark:border-white/15"
    >
      <span class="flex items-center gap-2 text-lg">
        <Icon name="mail" />
        Contact messages
      </span>
      <span class="text-3xl font-black tracking-tighter">{counts?.unread ?? 0}</span>
    </a>
    <a
      href="/admin/pages"
      class="flex items-center justify-between rounded-2xl border border-black/10 p-6 transition-transform hover:scale-[1.02] dark:border-white/15"
    >
      <span class="flex items-center gap-2 text-lg">
        <Icon name="document-text" />
        About / FAQ / Join
      </span>
      <span class="opacity-60">Edit</span>
    </a>
    <a
      href="/admin/settings"
      class="flex items-center justify-between rounded-2xl border border-black/10 p-6 transition-transform hover:scale-[1.02] dark:border-white/15"
    >
      <span class="flex items-center gap-2 text-lg">
        <Icon name="options" />
        Site settings
      </span>
      <span class="text-3xl font-black tracking-tighter">{authors}<span class="ml-2 text-sm font-medium opacity-60">authors</span></span>
    </a>
  </div>
</AdminLayout>
