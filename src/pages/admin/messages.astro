---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Flash from "@/components/admin/Flash.astro";
import { listSubmissions } from "@/lib/admin-db";
import { flashFromUrl } from "@/lib/admin";

export const prerender = false;

if (!Astro.locals.adminSession) return Astro.redirect("/admin/login");

const csrf = Astro.locals.adminCsrf;
const flash = flashFromUrl(Astro.url);

let messages: Awaited<ReturnType<typeof listSubmissions>> = [];
let dbError: string | null = null;
try {
  messages = await listSubmissions();
} catch (err) {
  dbError = err instanceof Error ? err.message : String(err);
}

const unread = messages.filter((message) => !message.read).length;

// The panel is read from wherever the operator happens to be, so the server
// cannot know which clock a stamp should be read against — and pinning the
// label to "(Sydney)" states something about the reader that is wrong as soon
// as they are sitting somewhere else. It renders UTC here, and the script at
// the foot of the page rewrites each stamp in the reader's own timezone,
// labelled with the place they are actually in. UTC is what stays if that
// script never runs.
const formatter = new Intl.DateTimeFormat("en-AU", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
});

function received(value: string | null): string {
  const date = value ? new Date(value) : null;
  if (!date || Number.isNaN(date.getTime())) return "—";
  return `${formatter.format(date)} (UTC)`;
}
---

<AdminLayout title="Messages" current="/admin/messages">
  {flash && <Flash kind={flash.kind} message={flash.message} />}

  <h1 class="mb-2 text-5xl font-bold leading-tight tracking-tighter">Contact messages</h1>
  <p class="mb-10 text-lg opacity-70">
    Submissions from the contact form. {unread} unread of {messages.length}. These are also emailed to
    the contact list when <code>RESEND_API_KEY</code> is set.
  </p>

  {dbError && (
    <div class="mb-8 rounded-2xl border border-red-500/40 bg-red-500/10 px-6 py-5">
      <p class="mb-1 font-semibold">Could not load messages.</p>
      <p class="font-mono text-sm opacity-80">{dbError}</p>
    </div>
  )}

  {
    messages.length === 0 ? (
      <p class="rounded-2xl border border-black/10 p-8 text-lg opacity-70 dark:border-white/15">
        No messages yet.
      </p>
    ) : (
      <div class="space-y-5">
        {messages.map((message) => (
          <article
            class:list={[
              "rounded-2xl border p-6",
              message.read ? "border-black/10 dark:border-white/15" : "border-blue-500/50 bg-blue-500/5",
            ]}
          >
            <div class="mb-3 flex flex-wrap items-baseline justify-between gap-3">
              <div>
                <span class="text-xl font-bold">
                  {message.name}
                  {!message.read && <span class="ml-3 text-sm font-semibold text-blue-700 dark:text-blue-300">NEW</span>}
                </span>
                <a href={`mailto:${message.email}`} class="ml-3 underline underline-offset-4 opacity-70">
                  {message.email}
                </a>
              </div>
              <time datetime={message.created_at ?? ""} data-received class="text-sm opacity-60">
                {received(message.created_at)}
              </time>
            </div>
            <p class="mb-5 whitespace-pre-line text-pretty text-lg">{message.message}</p>
            <div class="flex flex-wrap items-center gap-5 text-sm">
              <form action="/api/admin/messages" method="POST">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={message.id} />
                <input type="hidden" name="action" value={message.read ? "unread" : "read"} />
                <button type="submit" class="underline underline-offset-4">
                  Mark as {message.read ? "unread" : "read"}
                </button>
              </form>
              <a href={`mailto:${message.email}`} class="underline underline-offset-4">Reply by email</a>
              <form
                action="/api/admin/messages"
                method="POST"
                data-confirm="Delete this message permanently?"
              >
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={message.id} />
                <input type="hidden" name="action" value="delete" />
                <button type="submit" class="text-red-700 underline underline-offset-4 dark:text-red-400">
                  Delete
                </button>
              </form>
            </div>
          </article>
        ))}
      </div>
    )
  }

  {/* Rewrites every received-at stamp in the reader's own timezone and names the
      place from the address they are reading from: the device supplies the
      clock, the IP supplies the label, and the server's UTC render above is the
      fallback for both. */}
  <script>
    const stamps = document.querySelectorAll("time[data-received]");
    if (stamps.length) {
      const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const formatter = new Intl.DateTimeFormat("en-AU", {
        dateStyle: "medium",
        timeStyle: "short",
        timeZone: zone,
      });
      // The zone's own city is an honest label until the lookup answers, and
      // the only one if it never does — unlike a name pinned into the markup.
      let place = (zone.split("/").pop() ?? zone).replace(/_/g, " ") || zone;

      const paint = () => {
        for (const stamp of stamps) {
          const at = new Date(stamp.getAttribute("datetime") || "");
          if (Number.isNaN(at.getTime())) continue;
          stamp.textContent = `${formatter.format(at)} (${place})`;
        }
      };
      paint();

      fetch("/api/admin/geo")
        .then((response) => (response.ok ? response.json() : null))
        .then((geo) => {
          if (!geo || !geo.place) return;
          place = geo.place;
          paint();
        })
        .catch(() => {
          // The zone's city stands.
        });
    }
  </script>
</AdminLayout>
