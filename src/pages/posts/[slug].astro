---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CoverImage from "@/components/ui/CoverImage";
import DateComponent from "@/components/ui/DateComponent";
import { getSettings, getPostBySlug } from "@/lib/db";

const { slug } = Astro.params;
const settings = await getSettings();
const post = await getPostBySlug(slug!);

if (!post) {
  return Astro.redirect("/404");
}
---

<BaseLayout title={post.title} description={post.excerpt || undefined} settings={settings} ogImage={post.cover_image_url}>
  <div class="container mx-auto px-5">
    <h2 class="mb-8 mt-10 text-3xl font-bold leading-tight tracking-tight sm:text-4xl md:tracking-tighter">
      <a href="/" class="flex gap-2 sm:gap-3 items-center hover:underline">
        <img alt="Bulletin logo" class="size-[60px]" height={350} width={350} src="/bulletin.png" />
        Baulko Bulletin
      </a>
    </h2>

    <article>
      <h1 class="text-balance mb-12 text-6xl font-bold leading-tight tracking-tighter md:text-7xl md:leading-none">
        {post.title}
      </h1>

      <div class="mb-8 sm:mx-0 md:mb-16">
        <CoverImage client:load src={post.cover_image_url} alt={post.cover_image_alt} priority />
      </div>

      <div class="mx-auto max-w-2xl">
        <div class="mb-6 text-lg opacity-70">
          <DateComponent client:load dateString={post.date} />
        </div>
      </div>

      <div class="mx-auto max-w-2xl">
        <div class="prose prose-lg max-w-none" set:html={post.content} />

        {post.pdf_url && (
          <p class="mt-10">
            <a
              href={post.pdf_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-black text-white font-bold py-3 px-8 rounded-full hover:scale-105 transition-transform"
            >
              Download full PDF
            </a>
          </p>
        )}
      </div>
    </article>
  </div>
</BaseLayout>
