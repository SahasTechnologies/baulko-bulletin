---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SearchableCards from "@/components/ui/SearchableCards";
import { getSettings, getAllPostCards } from "@/lib/db";

const settings = await getSettings();
const posts = await getAllPostCards();
---

<BaseLayout title="Articles" settings={settings}>
  <div class="container mx-auto px-5">
    <PageHeader brand={settings.title} />
    <h1 class="mb-12 text-6xl font-bold leading-tight tracking-tighter md:text-7xl">
      Articles
    </h1>
    {
      posts.length === 0 ? (
        <p class="text-xl opacity-70">No issues published yet.</p>
      ) : (
        /* The grid and the search box are one island: filtering reorders the
           cards, so the query and the cards have to be rendered together. */
        <SearchableCards client:load items={posts} kind="issue" />
      )
    }
  </div>
</BaseLayout>
