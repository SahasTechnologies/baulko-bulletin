---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getSettings } from "@/lib/db";

export const prerender = false;

const settings = await getSettings();
const sent = Astro.url.searchParams.get("sent") === "1";
// A rejected submission comes back here with the reason, since the form posts
// without JavaScript and a JSON error page would be all the reader saw.
const error = Astro.url.searchParams.get("error");
// Public by design — the sitekey ships in the HTML. The secret stays server-side.
// This page is server-rendered, so either name works; PUBLIC_ is the Astro idiom.
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
  import.meta.env.TURNSTILE_SITE_KEY ||
  "0x4AAAAAAEzFFYWu-LrrOV_w";
---

<BaseLayout title="Contact" settings={settings}>
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
  <div class="container mx-auto px-5">
    <PageHeader brand={settings.title} />
    <div class="mx-auto max-w-xl">
      <h1 class="mb-4 text-5xl font-bold leading-tight tracking-tighter md:text-6xl">
        Contact Us
      </h1>
      <p class="mb-10 text-lg opacity-70">
        Questions, feedback, or want to contribute? Send a message below.
      </p>

      {error && (
        <div class="mb-8 rounded-2xl border border-red-500/40 bg-red-500/10 px-6 py-4 text-lg" role="alert">
          <p class="font-semibold mb-1">Your message was not sent.</p>
          <p class="opacity-80">{error}</p>
        </div>
      )}

      {sent ? (
        <div class="rounded-2xl bg-black/5 dark:bg-white/5 px-6 py-8 text-lg">
          <p class="font-semibold mb-2">Thanks — your message was sent.</p>
          <p class="opacity-70">We'll get back to you if a reply is needed.</p>
          <a href="/contact" class="inline-flex items-center gap-2 mt-6 underline">
            <Icon name="refresh" />
            Send another message
          </a>
        </div>
      ) : (
        <form action="/api/contact" method="POST" class="space-y-6">
          <div class="absolute left-[-9999px] top-auto h-0 w-0 overflow-hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input
              id="website"
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div>
            <label for="name" class="block text-sm font-medium mb-1">Name</label>
            <input
              id="name"
              type="text"
              name="name"
              required
              maxlength="200"
              class="w-full rounded-xl border border-black/15 dark:border-white/15 dark:bg-neutral-900 px-4 py-3 text-lg focus:outline-none focus:ring-2 focus:ring-black/30 dark:focus:ring-white/30"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium mb-1">Email</label>
            <input
              id="email"
              type="email"
              name="email"
              required
              maxlength="320"
              class="w-full rounded-xl border border-black/15 dark:border-white/15 dark:bg-neutral-900 px-4 py-3 text-lg focus:outline-none focus:ring-2 focus:ring-black/30 dark:focus:ring-white/30"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium mb-1">Message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              maxlength="5000"
              class="w-full rounded-xl border border-black/15 dark:border-white/15 dark:bg-neutral-900 px-4 py-3 text-lg focus:outline-none focus:ring-2 focus:ring-black/30 dark:focus:ring-white/30"
            ></textarea>
          </div>

          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-action="contact"
            data-theme="auto"
          >
          </div>

          <button
            type="submit"
            class="inline-flex items-center gap-2 bg-black dark:bg-white dark:text-black text-white font-bold py-3 px-10 rounded-full text-lg transition-transform hover:scale-105"
          >
            <Icon name="send" />
            Send message
          </button>
        </form>
      )}
    </div>
  </div>
</BaseLayout>
