---
import "@/styles/global.css";
import Icon from "@/components/ui/Icon.astro";
import type { Settings } from "@/types/content";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | null;
  settings: Settings;
}

const { title, description, ogImage, settings } = Astro.props;
const pageTitle = title ? `${title} | ${settings.title}` : settings.title;
const pageDescription = description || settings.description;

// The page's own image wins, then the site-wide default from Settings. Social
// crawlers resolve og:image against their own context, not ours, so a relative
// path like "/bulletin.png" (which the admin accepts) has to be made absolute
// here or it silently resolves to nothing.
const ogImageSource = ogImage || settings.og_image_url;
const ogImageUrl = (() => {
  if (!ogImageSource) return null;
  try {
    return new URL(ogImageSource, Astro.site ?? Astro.url).toString();
  } catch {
    return null;
  }
})();
---

<!doctype html>
<html lang="en" class="bg-white text-black dark:bg-neutral-950 dark:text-neutral-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <section class="min-h-screen">
      <main class="pb-16">
        <slot />
      </main>

      <footer class="px-6 mt-8">
        <div class="container mx-auto mb-10 px-8 md:px-10 bg-black/5 dark:bg-white/5 rounded-2xl">
          {settings.footer_html ? (
            <div
              class="prose prose-sm dark:prose-invert text-pretty w-full max-w-none py-12 text-center md:py-20"
              set:html={settings.footer_html}
            />
          ) : (
            <div class="flex flex-col gap-10 py-16 md:py-20 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
              <div class="flex flex-col gap-1 text-center lg:text-left">
                <h3 class="text-4xl font-bold leading-tight tracking-tighter lg:text-5xl">
                  Join the Bulletin.
                </h3>
                <h3 class="opacity-70 text-4xl font-bold leading-tight tracking-tighter lg:text-5xl">
                  Thursday lunches in C11
                </h3>
              </div>
              <div class="flex flex-col items-center lg:items-end gap-4">
                <p class="text-lg opacity-80">
                  For any questions or comments, feel free to
                </p>
                <a
                  href="/contact"
                  class="inline-flex items-center gap-2 bg-black dark:bg-white dark:text-black py-3 px-8 font-bold text-white transition-all hover:scale-110 text-lg rounded-full"
                >
                  <Icon name="chatbubbles" />
                  Contact Us
                </a>
                <div class="flex flex-col items-center lg:items-end text-sm opacity-50 gap-1 pt-1">
                  {/* Plain text rather than a flex row: the row's gaps added a
                      visible space on both sides of the ampersand, so the
                      credit line has to set its own spacing. The `{" "}`
                      expressions survive the whitespace compression that would
                      otherwise join the words and the links together. */}
                  <p class="text-center lg:text-right">
                    Website by{" "}
                    <a href="https://candra.dev" class="hover:underline">Darren Candra</a>{" "}
                    &amp;{" "}
                    <a href="https://shimpi.dev" class="hover:underline">Sahas Shimpi</a>
                  </p>
                  <a href="https://github.com/circles-png" class="hover:underline">Puzzles by Matthew Li</a>
                </div>
              </div>
            </div>
          )}
        </div>
      </footer>
    </section>
  </body>
</html>
