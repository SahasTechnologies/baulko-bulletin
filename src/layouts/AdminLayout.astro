---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { getSettings } from "@/lib/db";

export const prerender = false;

interface Props {
  title: string;
  /** Current path, used to highlight the active section. */
  current?: string;
}

const { title, current = "" } = Astro.props;
const settings = await getSettings();
const csrf = Astro.locals.adminCsrf;

const links = [
  { href: "/admin", label: "Dashboard", icon: "speedometer" },
  { href: "/admin/posts", label: "Issues", icon: "newspaper" },
  { href: "/admin/extras", label: "Extras", icon: "color-wand" },
  { href: "/admin/puzzles", label: "Puzzles", icon: "extension-puzzle" },
  { href: "/admin/pages", label: "Pages", icon: "document-text" },
  { href: "/admin/settings", label: "Settings", icon: "options" },
  { href: "/admin/messages", label: "Messages", icon: "mail" },
  { href: "/admin/contacts", label: "Contacts", icon: "paper-plane" },
];

const isActive = (href: string) =>
  href === "/admin" ? current === "/admin" : current === href || current.startsWith(`${href}/`);
---

<BaseLayout title={`${title} · Admin`} settings={settings}>
  <div class="container mx-auto px-5">
    <header
      class="mb-8 mt-10 flex flex-col gap-5 border-b border-black/10 pb-6 dark:border-white/10 lg:flex-row lg:items-center lg:justify-between"
    >
      <a href="/admin" class="flex items-center gap-3 text-3xl font-bold leading-tight tracking-tight hover:underline">
        <img alt="Bulletin logo" class="size-[52px]" height={350} width={350} src="/bulletin.png" />
        {settings.title}
        <span class="rounded-full bg-black/10 px-3 py-1 text-sm font-semibold tracking-normal dark:bg-white/15">
          Admin
        </span>
      </a>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-lg transition-transform hover:scale-105"
          target="_blank"
          rel="noreferrer"
        >
          <Icon name="open-outline" />
          View site
        </a>
        <form action="/api/admin/logout" method="POST">
          <input type="hidden" name="csrf" value={csrf} />
          <button
            type="submit"
            class="inline-flex items-center gap-1.5 rounded-full border border-black/15 px-5 py-2 text-lg transition-transform hover:scale-105 dark:border-white/20"
          >
            <Icon name="log-out-outline" />
            Sign out
          </button>
        </form>
      </div>
    </header>

    <nav class="icon-nav icon-nav-admin mb-10 text-lg font-medium">
      {
        links.map((link) => (
          <div class="icon-nav-item">
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class="icon-nav-link"
            >
              <Icon name={link.icon} />
              <span class="icon-nav-label">{link.label}</span>
            </a>
          </div>
        ))
      }
    </nav>

    <slot />

    {/* One listener for the whole panel instead of an inline `onsubmit` per form.
        A handler written as `onsubmit="return confirm('Delete “…”)'` interpolates
        the row's title into JavaScript source, so a title containing a quote or a
        backslash turned the handler into a syntax error and the form submitted
        without ever asking. `data-confirm` is a plain attribute, escaped by the
        template, and never parsed as code. */}
    <script is:inline>
      document.addEventListener("submit", (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        const message = form.dataset.confirm;
        if (message && !window.confirm(message)) event.preventDefault();
      });
    </script>
  </div>
</BaseLayout>
