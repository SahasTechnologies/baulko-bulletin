{
  "name": "baulko-bulletin",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/sync-pdfjs-assets.mjs",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs",
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "astro": "astro",
    "check": "astro check && node scripts/sync-icons.mjs --check && node scripts/sync-theme-morph.mjs --check && npm run logos:check && npm test",
    "test": "node --experimental-strip-types --test \"src/lib/*.test.ts\"",
    "icons": "node scripts/sync-icons.mjs && node scripts/sync-theme-morph.mjs",
    "morph": "node scripts/sync-theme-morph.mjs",
    "logo:dark": "node tools/make-logo-dark.mjs",
    "logo:light": "node tools/make-logo-dark.mjs --light",
    "logos:check": "node tools/make-logo-dark.mjs --check && node tools/make-logo-dark.mjs --light --check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/vercel": "^11.0.8",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.13",
    "astro": "^7.2.9",
    "date-fns": "^4.1.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
